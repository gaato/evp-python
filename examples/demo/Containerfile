# Image for the public demo (ghcr.io/gaato/pyevp-demo).  Build from the repository root:
#
#     podman build -f examples/demo/Containerfile -t pyevp-demo .
FROM ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 AS uv

FROM docker.io/library/python:3.14-slim@sha256:0741d101873c12ab927e6f8653feb8862b9bd58771177acb1b885b95141f91b4 AS build
COPY --from=uv /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY . .
RUN uv sync --locked --no-dev --no-editable --package pyevp-example-demo

FROM docker.io/library/python:3.14-slim@sha256:0741d101873c12ab927e6f8653feb8862b9bd58771177acb1b885b95141f91b4
COPY --from=build /src/.venv /src/.venv
COPY examples/demo/app.py /app/app.py
ENV PATH=/src/.venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
USER 65534:65534
EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--no-server-header"]
