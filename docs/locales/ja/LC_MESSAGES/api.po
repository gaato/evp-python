msgstr ""

#: of pyevp.contrib.django.issuer.IssuerSite.user_emails:1
msgid "Addresses the signed-in user may get tokens for; empty without a session."
msgstr ""

#: of pyevp.contrib.django.issuer.IssuerSite.user_emails:3
msgid ""
